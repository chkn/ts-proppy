{
  "name": "ts-proppy",
  "version": "0.2.0",
  "description": "Extract, edit, and materialize TypeScript prop definitions and values",
  "keywords": [
    "typescript",
    "props",
    "ast",
    "react",
    "editor",
    "codemod",
    "introspection"
  ],
  "author": "Alex Corrado",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chkn/ts-proppy.git"
  },
  "bugs": {
    "url": "https://github.com/chkn/ts-proppy/issues"
  },
  "homepage": "https://github.com/chkn/ts-proppy#readme",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.react.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/react": "^18.0.0",
    "react": "^18.0.0",
    "vitest": "^3.0.0"
  }
}
